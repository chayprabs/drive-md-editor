{
  "name": "markdrive",
  "version": "1.0.0",
  "private": true,
  "description": "Edit, preview, and save .md files directly in Google Drive.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsx scripts/check.ts",
    "release:verify": "tsx scripts/validate-release-readiness.ts",
    "preview": "vite preview --host 127.0.0.1",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:og": "tsx scripts/generate-og.ts",
    "lint:markers": "tsx scripts/assert-no-markers.ts",
    "lint:branding": "tsx scripts/validate-branding-invariants.ts",
    "lint:bundle": "tsx scripts/assert-bundle-size.ts",
    "lint:extension": "tsx scripts/validate-extension.ts",
    "lint:content": "tsx scripts/validate-content-invariants.ts",
    "lint:conflict": "tsx scripts/validate-conflict-invariants.ts",
    "lint:drive": "tsx scripts/validate-drive-invariants.ts",
    "lint:errors": "tsx scripts/validate-error-invariants.ts",
    "lint:export": "tsx scripts/validate-export-invariants.ts",
    "lint:markdown": "tsx scripts/validate-markdown-rendering.ts",
    "lint:media": "tsx scripts/validate-media-invariants.ts",
    "lint:editor": "tsx scripts/validate-editor-invariants.ts",
    "lint:search": "tsx scripts/validate-search-frontmatter-invariants.ts",
    "lint:settings": "tsx scripts/validate-settings-invariants.ts",
    "lint:ui": "tsx scripts/validate-ui-invariants.ts",
    "lint:workflow": "tsx scripts/validate-workflow-invariants.ts",
    "lint:perf": "tsx scripts/validate-performance-invariants.ts",
    "lint:stack": "tsx scripts/validate-stack-invariants.ts",
    "lint:store": "tsx scripts/validate-store-invariants.ts",
    "lint:docs": "tsx scripts/validate-docs.ts",
    "lint:git": "tsx scripts/validate-git-history.ts",
    "lint:oauth": "tsx scripts/validate-oauth.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/language": "^6.11.1",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@crxjs/vite-plugin": "^2.0.3",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-vim": "^6.2.1",
    "codemirror": "^6.0.1",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.511.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.317",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.5.0",
    "sharp": "^0.34.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9"
  }
}
